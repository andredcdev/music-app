# MongoDB connection string (Atlas or local). Data goes into the "music-app" database.
MONGODB_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/"

# OpenAI key used by /generate (model: gpt-5-nano)
OPENAI_API_KEY="sk-..."

# better-auth: any long random string, and the URL the app runs on
BETTER_AUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
